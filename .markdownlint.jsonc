{
  // MD013 - line-length: tables, URLs, descriptions naturally exceed 80 chars
  "MD013": false,
  // MD024 - no-duplicate-heading: repeated section names under different parents are intentional
  "MD024": false,
  // MD036 - no-emphasis-as-heading: bold text used as inline labels, not misused headings
  "MD036": false,
  // MD040 - fenced-code-language: many blocks are plain-text output or pseudocode
  "MD040": false,
  // MD060 - table-column-style: compact pipe syntax is consistent repo style
  "MD060": false
}
