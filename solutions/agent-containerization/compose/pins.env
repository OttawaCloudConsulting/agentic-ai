# Machine-readable derivative of docs/records/agent-verification.md.
# Passed to `docker compose` as --env-file (see feature plan criterion 4).
# The smoke check asserts this file agrees with the human record — a
# hand-edit to either is caught, not silently shipped.

CLAUDE_VERSION=2.1.260
CLAUDE_SOURCE=npm:@anthropic-ai/claude-code@2.1.260

CODEX_VERSION=0.152.1
CODEX_SOURCE=npm:@openai/codex@0.152.1

# agy has no version-pinning flag (agent-verification.md). Pinned instead by
# direct, checksum-verified download of the manifest-resolved artifact for
# linux_arm64 (Docker Desktop on Apple silicon, A1) -- see
# docs/records/agent-verification.md, "agy version pin -- resolved".
AGY_VERSION=1.1.26
AGY_SOURCE=https://storage.googleapis.com/antigravity-public/antigravity-cli/1.1.26-5550154686791680/linux-arm/cli_linux_arm64.tar.gz
AGY_URL=https://storage.googleapis.com/antigravity-public/antigravity-cli/1.1.26-5550154686791680/linux-arm/cli_linux_arm64.tar.gz
AGY_SHA512=332dddb06ab4d901a44cfd4b9b358848230e64a64515a8e79b03822348adac9ce92d54cb4fc5119ef075edfba922820c926dfddf82d3a49f4ecdb6e6704dfc75

# Mediator image pins (01.3 SF-4). Machine-readable derivative of
# docs/records/mediator-selection.md, which verified P1-P8 against exactly this
# build. Both halves matter: Debian point releases supersede in place, so an
# unpinned install moves off the verified build while the version-scoped Squid
# directives keep parsing. The smoke check asserts the squid pin and the base
# digest agree with the record.
MEDIATOR_BASE_DIGEST=sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132
SQUID_VERSION=6.13-2+deb13u2

# unbound is the resolver binary SF-5 configures. Not verified by SF-1 -- SF-1's
# properties are the proxy's -- so it is pinned here but not asserted against the
# selection record.
UNBOUND_VERSION=1.22.0-2+deb13u3
